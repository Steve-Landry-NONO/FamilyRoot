# ============================================
# FamilyRoots — Environment Variables
# ============================================
# ⚠️ NE JAMAIS COMMIT CE FICHIER
# Copie ce template vers .env et remplis les valeurs
# ============================================

# ===================
# SUPABASE
# ===================
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database (Direct connection - pour Prisma)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ===================
# JWT (Supabase utilise son propre JWT)
# ===================
JWT_SECRET=your-supabase-jwt-secret

# ===================
# APP CONFIG
# ===================
NODE_ENV=development
PORT=4000

# ===================
# FLUTTER (à copier dans lib/config/)
# ===================
# FLUTTER_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# FLUTTER_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
